# Copy to .env and fill in real values. NEVER commit .env to git.

# ── Solana ───────────────────────────────────────────────
SOLANA_PRIVATE_KEY=YOUR_BASE58_ENCODED_PRIVATE_KEY
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# ── EVM / Ethereum ───────────────────────────────────────
ETH_PRIVATE_KEY=YOUR_HEX_ENCODED_ETH_PRIVATE_KEY_NO_0x_PREFIX
ETH_RPC_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_INFURA_PROJECT_ID
ETH_RPC_HTTP_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Separate key for Flashbots reputation (can be any fresh EOA, not your trading wallet)
FLASHBOTS_SIGNING_KEY=YOUR_HEX_FLASHBOTS_SIGNER_KEY_NO_0x_PREFIX
